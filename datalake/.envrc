source_up_if_exists
unset VIRTUAL_ENV
uv sync --frozen --quiet
source .venv/bin/activate
export DBT_PROFILES_DIR=profiles
if [ -n "${LOCAL_APP_POSTGRES_URL:-}" ]; then
  _u="${LOCAL_APP_POSTGRES_URL#*://}"
  _userpass="${_u%%@*}"
  _hostdbname="${_u#*@}"
  export DBT_USER="${_userpass%%:*}"
  export DBT_PASSWORD="${_userpass#*:}"
  _hostport="${_hostdbname%%/*}"
  export DBT_DBNAME="${_hostdbname#*/}"
  export DBT_HOST="${_hostport%%:*}"
  export DBT_PORT="${_hostport##*:}"
fi
if [ ! -d dbt_packages ] || [ packages.yml -nt dbt_packages ]; then
  dbt deps --profiles-dir profiles --quiet
fi
