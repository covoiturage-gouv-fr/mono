set dotenv-load
set shell := ["bash", "-uc"] 

default:
  @just --list

# charge local .env
dbt-env:
  set -a; source .env; set +a

# Run dbt command
dbt cmd *args:
  dbt {{cmd}} {{args}} --profiles-dir profiles

# Supprime une fenêtre temporelle puis relance proprement (évite les lignes fantômes)
# ex: just dbt-recompute models/aggregated/od 2026-01-01 2027-01-01
dbt-recompute path start end *args:
  #!/usr/bin/env bash
  set -e
  DBT_PROFILES_DIR=profiles dbt run-operation delete_window \
    --args "{\"path_prefix\": \"{{path}}\", \"start\": \"{{start}}\", \"end\": \"{{end}}\"}"
  DBT_PROFILES_DIR=profiles dbt run \
    --select "{{path}}" \
    --vars "{\"start\":\"{{start}}\",\"end\":\"{{end}}\"}" \
    {{args}}

# Run dbt-osmosis command
dbt-osmosis cmd *args:
  dbt-osmosis {{cmd}} {{args}} --profiles-dir profiles --project-dir .

# Génère les YMLs pour une couche (ex: just osmosis-refactor trusted)
osmosis-refactor layer *args:
  dbt-osmosis yaml refactor --fqn covoiturage.{{layer}} --profiles-dir profiles --project-dir . {{args}}

# Dry-run : affiche les changements sans écrire sur disque
osmosis-dry-run layer *args:
  dbt-osmosis yaml refactor --fqn covoiturage.{{layer}} --profiles-dir profiles --project-dir . --dry-run {{args}}

# Affiche la documentation dbt dans le navigateur
docs-serve *args:
  dbt docs serve --profiles-dir profiles {{args}}

# Lint SQL models with sqlfluff
lint *args:
  DBT_PROFILES_DIR=profiles sqlfluff lint --processes 1 {{ if args == "" { "models/ tests/ macros/ analyses/" } else { args } }}

# Lint SQL models and auto-fix violations (exit 1 = unfixable violations remain, not a failure)
lint-fix *args:
  -DBT_PROFILES_DIR=profiles sqlfluff fix --processes 1 {{ if args == "" { "models/ tests/ macros/ analyses/" } else { args } }}

# Seed data from S3 to Postgres
seed config schema *args:
  python -m pipelines.cmd.seed  pipelines/config/{{config}} {{schema}} {{args}}

# Export data from Postgres to S3
export config schema *args:
  python -m pipelines.cmd.export pipelines/config/{{config}} {{schema}} {{args}}

# Backfill par mois pour éviter les timeouts

backfill-batch model period start end *args:
  #!/usr/bin/env bash
  current="{{ start }}"
  period="{{ period }}"
  while [[ "$current" < "{{ end }}" ]]; do
    next=$(date -d "$current +1 $period" +%Y-%m-%d)
    echo "▶️  Processing $current → $next"
    vars="{start: $current, end: $next}"
    dbt run --profiles-dir profiles --select {{model}} --vars "{start: \"$current\", end: \"$next\"}" {{ args }}
    current=$next
  done

# Pipeline 1: Seed raw data from S3 to raw_zone (yearly)
pipeline-raw *args:
  just seed raw/seed_perimeters.json zone_raw --folder seeds {{ if args =~ "--full-refresh" { "--overwrite" } else { "" } }}
  just seed raw/seed_datagouv.json zone_raw {{ if args =~ "--full-refresh" { "--overwrite" } else { "" } }}

# Pipeline 2: trusted geo (yearly)
pipeline-trusted-geo *args:
  just dbt build --select "tag:trusted,tag:geo" {{args}}

# Pipeline 3 : daily update:
pipeline-daily *args:
  just dbt build --select "tag:daily" {{args}}
