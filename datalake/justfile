set dotenv-load
set shell := ["bash", "-uc"] 

default:
  @just --list

# charge local .env
dbt-env:
  set -o allexport; source .env; set +o allexport

# Run dbt
dbt cmd:
    dbt {{cmd}} --profiles-dir profiles 

# Run pipeline import external data
pipeline-external-data:
  python -m pipelines.runners.import_external_data

