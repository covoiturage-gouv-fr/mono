set dotenv-load
set shell := ["bash", "-uc"] 

default:
  @just --list

# charge local .env
dbt-env:
  set -a; source .env; set +a

# Run dbt command
dbt cmd *args:
  dbt {{cmd}} {{args}} --profiles-dir profiles 

# Run dbt-osmosis command
dbt-osmosis cmd *args:
  dbt-osmosis {{cmd}} {{args}} --profiles-dir profiles --project-dir .

# Génère les YMLs pour une couche (ex: just osmosis-refactor trusted)
osmosis-refactor layer *args:
  dbt-osmosis yaml refactor --fqn covoiturage.{{layer}} --profiles-dir profiles --project-dir . {{args}}

# Dry-run : affiche les changements sans écrire sur disque
osmosis-dry-run layer *args:
  dbt-osmosis yaml refactor --fqn covoiturage.{{layer}} --profiles-dir profiles --project-dir . --dry-run {{args}}

# Affiche la documentation dbt dans le navigateur
docs-serve *args:
  dbt docs serve --profiles-dir profiles {{args}}

# Lint SQL models with sqlfluff (per-file to avoid dbt connection bursts)
lint *args:
  #!/usr/bin/env bash
  set -e
  find models analyses -name '*.sql' -print0 \
    | xargs -0 -I {} sh -c 'DBT_PROFILES_DIR=profiles sqlfluff lint --processes 1 "$1" {{args}}' _ {}

# Lint SQL models and auto-fix violations (per-file to avoid dbt connection bursts)
lint-fix *args:
  #!/usr/bin/env bash
  find models analyses -name '*.sql' -print0 \
    | xargs -0 -I {} sh -c 'DBT_PROFILES_DIR=profiles sqlfluff fix --processes 1 "$1" {{args}}' _ {}

# Lint SQL models with sqlfluff (per-file to avoid dbt connection bursts)
lint *args:
