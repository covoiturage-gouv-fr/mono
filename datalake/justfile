set dotenv-load
set shell := ["bash", "-uc"]

# Backfill historique groupé : `just backfill all`, `just backfill trusted`, …
mod backfill "backfill.justfile"

# dbt écrit ses artefacts (target/) et ses logs (logs/) sous le répertoire projet. En pod,
# ce répertoire est en lecture seule (/data appartient à root) => on redirige vers un chemin
# inscriptible. Surchargé par l'env du pod si présent ; hérité par le module backfill.
export DBT_TARGET_PATH := env_var_or_default("DBT_TARGET_PATH", "/tmp/dbt/target")
export DBT_LOG_PATH := env_var_or_default("DBT_LOG_PATH", "/tmp/dbt/logs")

default:
  @just --list

# charge local .env
dbt-env:
  set -a; source .env; set +a

# Run dbt command
dbt cmd *args:
  dbt {{cmd}} {{args}} --profiles-dir profiles

# Apply datalake DB migrations (custom functions, grants). Idempotent — run at each deploy.
migrate *args:
  python -m pipelines.cmd.migrate {{args}}

# Supprime une fenêtre temporelle puis relance proprement (évite les lignes fantômes)
# ex: just dbt-recompute models/aggregated/od 2026-01-01 2027-01-01
dbt-recompute path start end *args:
  #!/usr/bin/env bash
  set -e
  DBT_PROFILES_DIR=profiles dbt run-operation delete_window \
    --args "{\"path_prefix\": \"{{path}}\", \"start\": \"{{start}}\", \"end\": \"{{end}}\"}"
  DBT_PROFILES_DIR=profiles dbt run \
    --select "{{path}}" \
    --vars "{\"start\":\"{{start}}\",\"end\":\"{{end}}\"}" \
    {{args}}

# Run dbt-osmosis command
dbt-osmosis cmd *args:
  dbt-osmosis {{cmd}} {{args}} --profiles-dir profiles --project-dir .

# Génère les YMLs pour une couche (ex: just osmosis-refactor trusted)
osmosis-refactor layer *args:
  dbt-osmosis yaml refactor --fqn covoiturage.{{layer}} --profiles-dir profiles --project-dir . {{args}}

# Dry-run : affiche les changements sans écrire sur disque
osmosis-dry-run layer *args:
  dbt-osmosis yaml refactor --fqn covoiturage.{{layer}} --profiles-dir profiles --project-dir . --dry-run {{args}}

# Affiche la documentation dbt dans le navigateur
docs-serve *args:
  dbt docs serve --profiles-dir profiles {{args}}

# Lint SQL models with sqlfluff
lint *args:
  DBT_PROFILES_DIR=profiles sqlfluff lint --processes 1 {{ if args == "" { "models/ tests/ macros/ analyses/" } else { args } }}

# Lint SQL models and auto-fix violations (exit 1 = unfixable violations remain, not a failure)
lint-fix *args:
  -DBT_PROFILES_DIR=profiles sqlfluff fix --processes 1 {{ if args == "" { "models/ tests/ macros/ analyses/" } else { args } }}

# Seed data from S3 to Postgres
seed config schema *args:
  python -m pipelines.cmd.seed  pipelines/config/{{config}} {{schema}} {{args}}

# Calcule le SHA256 des fichiers sources S3 (--write pour les inscrire en config)
checksum config *args:
  python -m pipelines.cmd.checksum pipelines/config/{{config}} {{args}}

# Régénère le GPKG old_perimeters (archive) depuis zone_trusted.perimeters et l'upload sur S3.
# Étape suivante : `just checksum raw/seed_raw.json --folder seeds --write`
archive-old-perimeters *args:
  python -m pipelines.cmd.archive_perimeters {{args}}

# Réconcilie les sources d'une config avec notre S3 : recopie les manquantes accessibles, signale les manuelles
mirror config *args:
  python -m pipelines.cmd.mirror pipelines/config/{{config}} {{args}}

# Export data from Postgres to S3
export config schema *args:
  python -m pipelines.cmd.export pipelines/config/{{config}} {{schema}} {{args}}

# Drain the on-demand export queue (claims from API, writes to export bucket)
export-worker *args:
  python -m pipelines.cmd.export_worker {{args}}

# Publication open-data mensuelle sur data.gouv.fr (défaut : mois précédent).
datagouv *args:
  python -m pipelines.cmd.datagouv {{args}}

# Rafraîchit les stats locales des tables distantes (FDW, schema dlk_import).
# Autovacuum n'analyse JAMAIS les foreign tables : sans ce pas, `reltuples = -1`
# (aucune stat). À lancer avant un backfill lourd pour donner au planner de bonnes
# estimations sur les fragments non délégués au serveur distant.
analyze-sources:
  python -m pipelines.cmd.analyze

# Backfill par mois pour éviter les timeouts et borner la mémoire.
# GUCs de session (via PGOPTIONS) : work_mem réduit + gather non parallèle bornent
# le pic mémoire (sinon work_mem × workers parallèles × threads → OOM, backend tué =
# « SSL SYSCALL error: EOF »). synchronous_commit=off : sans risque pour un backfill
# rejouable. DBT_THREADS surchargeable (défaut 3 : concurrence sûre une fois bornée).
backfill-batch model period start end *args:
  #!/usr/bin/env bash
  current="{{ start }}"
  period="{{ period }}"
  export PGOPTIONS="${PGOPTIONS:--c work_mem=96MB -c max_parallel_workers_per_gather=1 -c synchronous_commit=off}"
  export DBT_THREADS="${DBT_THREADS:-3}"
  while [[ "$current" < "{{ end }}" ]]; do
    next=$(date -d "$current +1 $period" +%Y-%m-%d)
    echo "▶️  Processing $current → $next"
    vars="{start: $current, end: $next}"
    dbt run --profiles-dir profiles --select {{model}} --vars "{start: \"$current\", end: \"$next\"}" {{ args }}
    current=$next
  done

# Backfill historique complet : module `backfill` (voir backfill.justfile) => `just backfill …`
# (`just backfill all`, `backfill trusted`, `backfill aggregated`, `backfill exposed`).

# Pipeline 1: Seed raw data from S3 to raw_zone (yearly). Toutes les sources sont dans notre S3
# (data.gouv recopié via `just mirror`), empreintes vérifiées par défaut.
pipeline-raw *args:
  just seed raw/seed_raw.json zone_raw --folder seeds {{ if args =~ "--full-refresh" { "--overwrite" } else { "" } }}

# Pipeline 2: trusted geo (yearly)
pipeline-trusted-geo *args:
  just dbt run --select "tag:trusted,tag:geo" {{args}}

# Pipeline 3 : daily update (agrégés taggés daily + zone exposée + invalidation du cache).
# Un seul `dbt run` sur l'union => dbt ordonne le DAG (agrégés frais avant l'exposé).
pipeline-daily *args:
  just dbt run --select "tag:daily" "models/exposed" {{args}}
  just cache-bump

# Invalide le cache de l'API observatoire (INCR obs:cache:version). No-op sans REDIS_URL.
cache-bump:
  python -m pipelines.cmd.cache_bump

# Zone exposée seule + invalidation du cache (usage manuel/backfill ; le cron ops appelle pipeline-daily).
pipeline-exposed *args:
  just dbt run --select "models/exposed" {{args}}
  just cache-bump
