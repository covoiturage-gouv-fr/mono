# Copier en `.env` : `cp .env.example .env`
# Les valeurs ci-dessous fonctionnent en local contre le Postgres Docker
# (`docker compose up -d postgres` depuis la racine du dépôt), qui expose
# par défaut postgres/postgres sur 127.0.0.1:5432, base `local`.

# --- Connexion dbt (profil `default`, cf. profiles/profiles.yml) ---
# Tous les paramètres du profil sont lus depuis ces variables.
DBT_HOST=127.0.0.1
DBT_PORT=5432
DBT_USER=postgres
DBT_PASSWORD=postgres
DBT_DBNAME=local
DBT_SCHEMA=
DBT_THREADS=6

# Cible du profil : `dev` en local, `prod` en production.
DBT_TARGET=dev
# Répertoire du profil dbt (relatif à datalake/).
DBT_PROFILES_DIR=profiles

# URL de la même base, utilisée par certains scripts/outils locaux.
LOCAL_APP_POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/local

# --- Stockage objet S3 (ETL : `just seed` / `just export`) ---
# Non requis pour `dbt parse/compile/run`. Renseigner pour les pipelines S3.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_BUCKET=

# --- Export bucket (on-demand exports; different lifecycle/creds than S3_*) ---
EXPORT_S3_ENDPOINT=
EXPORT_S3_ACCESS_KEY=
EXPORT_S3_SECRET_KEY=
EXPORT_S3_BUCKET=
# --- API control plane ---
API_URL=
EXPORT_WORKER_ACCESS_KEY=
EXPORT_WORKER_SECRET_KEY=
