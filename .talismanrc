    checksum: 5c8511305a8806cf773f0e0b92c4576e6a8f7ab3e3e27e138f474466d6ff79e8
  - filename: api/deno.lock
    allowed_patterns:
      - "sha512-.*"
      - '"[0-9a-f]{64}"'
  - filename: api/src/pdc/services/cee/config/signature.ts
    checksum: bc1b5afcb79fb043a259ffe7cccd6e7d805c5d43ef0430d1fc73809de9adf0fc
