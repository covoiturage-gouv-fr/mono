# Base datalake (mêmes variables que dbt/pipelines)
DBT_HOST=localhost
DBT_PORT=5432
DBT_USER=postgres
DBT_PASSWORD=
DBT_DBNAME=datalake

# Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400

# Fenêtre de publication (borne supérieure exclusive, YYYY-MM-DD). Vide = pas de filtre.
APP_OBSERVATORY_PUBLISHED_UNTIL=

# CORS (origines autorisées, séparées par des virgules)
CORS_ORIGINS=*
